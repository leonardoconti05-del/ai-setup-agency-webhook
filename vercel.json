{
  "crons": [
    {
      "path": "/api/cron/follow-up",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/retention",
      "schedule": "30 3 * * *"
    }
  ],
  "regions": [
    "fra1"
  ],
  "rewrites": [
    {
      "source": "/api/admin-pack",
      "destination": "/api/cron/retention?modo=admin-pack"
    }
  ],
  "functions": {
    "api/cron/retention.js": {
      "maxDuration": 60
    }
  }
}
